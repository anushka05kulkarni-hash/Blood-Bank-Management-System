<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Blood Bank Dashboard</title>

<style>
body {
  font-family: Arial;
  background: #f4f6f8;
}

header {
  background: #c62828;
  color: white;
  padding: 15px;
  text-align: center;
}

.container {
  display: flex;
  gap: 20px;
  padding: 20px;
}

.cards {
  flex: 2;
}

.card {
  background: white;
  padding: 10px;
  margin: 10px 0;
  border-radius: 8px;
}

button {
  margin-top: 5px;
  padding: 5px 10px;
  background: #c62828;
  color: white;
  border: none;
  cursor: pointer;
}

.panel {
  flex: 1;
  background: white;
  padding: 10px;
  border-radius: 8px;
}
</style>

</head>
<body>

<header>Blood Bank Management</header>

<div style="padding: 10px;">
  <button onclick="addDonor()">Add Donor</button>
</div>

<div class="container">
  <div class="cards" id="cards"></div>

  <div class="panel">
    <h3>Status Panel</h3>
    <p id="total"></p>
    <p id="available"></p>
  </div>
</div>

<script>
let donors = [
  {name: "Anu", group: "A+", available: true},
  {name: "Rahul", group: "B-", available: false}
];

//Render function (VDOM concept simulation)
function render() {
  let cards = document.getElementById("cards");
  cards.innerHTML = "";

  let total = donors.length;
  let availableCount = donors.filter(d => d.available).length;

  donors.forEach((d, index) => {
    let div = document.createElement("div");
    div.className = "card";

    div.innerHTML = `
      <h4>${d.name}</h4>
      <p>Blood: ${d.group}</p>
      <p>Status: ${d.available ? "Available" : "Not Available"}</p>
      <button onclick="toggleStatus(${index})">Toggle Status</button>
    `;

    cards.appendChild(div);
  });

  document.getElementById("total").innerText = "Total: " + total;
  document.getElementById("available").innerText = "Available: " + availableCount;
}

//DOM Update
function toggleStatus(index) {
  donors[index].available = !donors[index].available;
  render(); // re-render (VDOM idea)
}

//Add donor
function addDonor() {
  let name = prompt("Enter name:");
  let group = prompt("Enter blood group:");

  if(name && group){
    donors.push({name, group, available: true});
    render();
  }
}

// Initial render
render();
</script>

</body>
</html>
